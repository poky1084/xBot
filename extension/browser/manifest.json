{
  "name": "Originals Request Proxy",
  "description": "Forwards xBot's requests to the casino tab you have open (Stake, Shuffle, Goated, Wolfbet, Duel) and sends the answers back.",
  "manifest_version": 3,
  "version": "2.1.0",
  "permissions": [
    "webNavigation",
    "scripting",
    "tabs",
    "activeTab",
    "webRequest",
    "webRequestAuthProvider",
    "cookies"
  ],
  "host_permissions": [
    "https://*.stake.bet/*",
    "https://*.stake.com/*",
    "https://*.stake.pet/*",
    "https://*.stake.kim/*",
    "https://*.stake.us/*",
    "https://*.stake.games/*",
    "https://*.stake.mba/*",
    "https://*.stake.ac/*",
    "https://*.stake.jp/*",
    "https://*.stake.bz/*",
    "https://*.stake.krd/*",
    "https://*.stake.ceo/*",
    "https://*.staketr.com/*",
    "https://*.primedice.com/*",
    "https://*.primedice.games/*",
    "https://*.stake1021.com/*",
    "https://*.stake1067.com/*",
    "https://*.stake3075.com/*",
    "https://*.shuffle.com/*",
    "https://*.shuffle.game/*",
    "https://*.goated.com/*",
    "https://*.wolfbet.com/*",
    "https://*.duel.com/*",
    "https://*.duel.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "index.js"
      ],
      "matches": [
        "https://*/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
