{
    "manifest_version": 3,
    "name": "stake-strategy",
    "description": "export/import",
    "version": "1.0.0.0",
    "icons": {
        "128": "icon.png"
    },
    "options_page": "",
    "action": {
        "default_title": "stake-strategy"
    },
    "permissions": [],
    "host_permissions": [
        "*://*/*"
    ],
    "background": {
    },
    "content_scripts": [{
        "js": ["index.js"],
        "matches": ["https://stake.bet/*", "https://stake.com/*", "https://stake.pet/*", "https://stake.kim/*", "https://stake.us/*", "https://stake.games/*", "https://stake.mba/*", "https://stake.ac/*", "https://stake.jp/*", "https://stake.bz/*", "https://stake.ceo/*", "https://stake.krd/*", "https://stake.jp/*", "https://staketr.com/*", "https://primedice.com/*", "https://stake1067.com/*", "https://stake3075.com/*"],
		"run_at": "document_end"
    }],
	"content_security_policy": {
		"extension_pages": "script-src 'self'; object-src 'self';"
	}
}